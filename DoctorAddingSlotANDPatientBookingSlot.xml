<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite" verbose="1">
<test name="Test" preserve-order="true">
<!-- 
      preserve-order="true" is required here (not just default behaviour):
      PatientBookingSlot functionally depends on DoctorAddingSlot having run
      first (a slot must exist before it can be booked). Do not remove this
      attribute or reorder the classes below.
     -->
<classes>
<class name="all.DoctorAddingSlot"/>
<class name="all.PatientBookingSlot"/>
</classes>
</test>
<!--  Test  -->
</suite>
